PORT=3000
DATABASE_URL=postgresql://user:password@hostname:5432/dbname
JWT_SECRET=replace_with_strong_unique_random_hex_or_base64_secret_minimum_32_chars
UPLOAD_DIR=uploads
PG_POOL_MAX=20
TRUST_PROXY=false # Set to true/1 ONLY when running behind a trusted reverse proxy (Nginx, Cloudflare, ALB)
PG_SSL_REJECT_UNAUTHORIZED=true # Verify remote PostgreSQL SSL certificates (default: true)
RENDER_SERVICE_ID= # Optional: Render service ID (e.g. srv-...) for automated SSL & custom domain binding
RENDER_API_KEY= # Optional: Render API key for automated custom domain registration
